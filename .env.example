# ── Application ──────────────────────────────────────────────────────────────
PROJECT_NAME=Warehouse AI ERP
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_STR=/api/v1

# ── DuckDB ────────────────────────────────────────────────────────────────────
DUCKDB_DATABASE=warehouse.db
DUCKDB_READ_ONLY=false

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
